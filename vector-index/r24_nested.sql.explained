Original Statement:
------------------
SELECT 
  id,
  VECTOR_DISTANCE(v, 
                  (SELECT 
                     v 
                   from 
                     v_random24 
                   FETCH FIRST 1 ROWS ONLY
                  ), EUCLIDEAN) AS DISTANCE 
FROM 
  v_random24 
WHERE 
  V IS NOT NULL 
ORDER BY 
  DISTANCE ASC 
FETCH approx FIRST 10 ROWS ONLY


Optimized Statement:
-------------------
SELECT 
  Q5.ID AS "ID",
  Q5.$C1 AS "DISTANCE" 
FROM 
  (SELECT 
     Q4.ID,
     VECTOR_DISTANCE(Q4.V, 
                     (SELECT 
                        Q2.V 
                      FROM 
                        (SELECT 
                           Q1.V 
                         FROM 
                           HLOESER.V_RANDOM24 AS Q1
                        ) AS Q2
                     ), EUCLIDEAN) 
   FROM 
     HLOESER.V_RANDOM24 AS Q4
  ) AS Q5 
ORDER BY 
  Q5.$C1

