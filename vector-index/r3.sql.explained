Original Statement:
------------------
SELECT 
  id,
  VECTOR_DISTANCE(v, vector('[-1.02,0.95, 1.55]', 3, float32), EUCLIDEAN) AS DISTANCE 
FROM 
  v_random 
ORDER BY 
  DISTANCE ASC 
FETCH approx FIRST 200 ROWS ONLY /* <OPTGUIDELINES> <IXSCAN TABLE='V_RANDOM' INDEX='V_RANDOM_INDEX'/> </OPTGUIDELINES> */


Optimized Statement:
-------------------
SELECT 
  Q2.ID AS "ID",
  Q2.$C1 AS "DISTANCE" 
FROM 
  (SELECT 
     Q1.ID,
     VECTOR_DISTANCE(Q1.V, VECTOR('[-1.02,0.95, 1.55]', 3, FLOAT32), EUCLIDEAN) 
   FROM 
     HLOESER.V_RANDOM AS Q1
  ) AS Q2 
ORDER BY 
  Q2.$C1

